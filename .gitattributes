# Normaliza los finales de linea en el repositorio y usa CRLF al descargar en Windows.
# Los .ps1 van en UTF-8 con BOM: git no toca el BOM, pero no los guardes sin el.
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md  text eol=crlf

*.png binary
*.jpg binary
*.ico binary

# Fuera del ZIP de las releases (git archive): a quien lo descarga no le sirven de nada
.gitattributes export-ignore
.gitignore     export-ignore
/tests         export-ignore
/docs/CrearIcono.ps1 export-ignore
